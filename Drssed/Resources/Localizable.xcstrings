      "localizations" : {
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Du bist als Gast unterwegs: Wenn du dich bei einem bestehenden Konto anmeldest, gehen deine Kleidungsstücke und Outfits verloren. Mit einem Account-Upgrade nimmst du sie mit." }
        },
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "You're here as a guest: signing in to an existing account discards your clothes and outfits. Upgrading your account keeps them." }
