    "auth.reset.confirmation" : {
      "comment" : "Shown after requesting a password reset link. Deliberately does not confirm whether the account exists.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn es zu dieser Adresse ein Konto gibt, ist die E-Mail unterwegs. Schau auch im Spam-Ordner nach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If an account exists for that address, the email is on its way. Check your spam folder, too."
          }
        }
      }
    },
